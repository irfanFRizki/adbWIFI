{
  "appId": "com.irfanfrizki.telemetry",
  "appName": "Telemetry Server",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystorePassword": null,
      "keystoreAlias": null,
      "keystoreAliasPassword": null,
      "releaseType": "APK"
    },
    "allowMixedContent": true,
    "cleartext": true,
    "loggingBehavior": "debug"
  },
  "ios": {
    "contentInset": "automatic"
  },
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "TelemetryBridge": {
      "android": "com.irfanfrizki.telemetry.bridge.TelemetryBridgePlugin"
    }
  }
}